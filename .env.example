# ============================================================
# CORPORATE HELL™ — environment template
# Copy to `.env` (repo root). NEVER commit real credentials.
# ============================================================

# --- Backend: NVIDIA AI (server-side only, never exposed to the browser) ---
# Get a key at https://build.nvidia.com (NVIDIA NIM catalog).
# The game is fully playable without a key — it falls back to
# deterministic local dialogue templates.
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Request tuning (defaults shown; all optional)
AI_REQUEST_TIMEOUT_SECONDS=8
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=12
AI_CACHE_SIZE=256

# Local SQLite database for server-side save snapshots
DATABASE_URL=sqlite:///./corporate_hell.db
AUTO_CREATE_TABLES=true

# --- Frontend: Vite (only VITE_* variables reach the browser) ---
# The API base URL is not a secret. Do NOT put NVIDIA_API_KEY here
# and do NOT prefix it with VITE_.
VITE_API_BASE_URL=http://localhost:8000/api
